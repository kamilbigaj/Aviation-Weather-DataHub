# Sensitive credentials and API keys
.env

# Python virtual environments and cache files
venv/
__pycache__/
*.pyc

# Raw downloaded data (excluded from version control)
*.json
*.csv

# IDE and editor settings (JetBrains, PyCharm, VS Code)
.idea/
.vscode/

# Application and system logs
logs/

# macOS system files (to avoid committing system-generated files)
.DS_Store

# Metabase local configuration and dashboards (excluded from version control)
metabase-data/